---
import Button from '../atoms/Button.astro';
import Price from '../atoms/Price.astro';
interface Props {
  product: any;
  presentation: any;
  mode?: 'home' | 'business';
}
const { product, presentation, mode = 'home' } = Astro.props;
const price = mode === 'business' ? presentation.wholesalePrices?.priceFor?.(1) : presentation.retailPrices?.priceFor?.(1);
---
<article class="product-card border border-neutral/20 rounded-lg p-4 bg-surface">
  <h3 class="text-label font-medium">{product.name}</h3>
  <p class="text-help text-neutral">{presentation.name}</p>
  <div class="mt-2">
    <Price amount={price?.amount ?? 0} />
  </div>
  <div class="mt-3">
    <Button variant="primary">Agregar</Button>
  </div>
</article>
<script>
  // placeholder: wire add-to-cart via container in future
</script>
