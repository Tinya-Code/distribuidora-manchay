---
// NotFoundPage (dumb view) — recibe todo por props, sin lógica de negocio, sin layout
interface Props {
  title?: string;
}
const {
  title = '404',
} = Astro.props;
---

<main class="container mx-auto px-4 py-8">
  <h1 class="text-section font-display text-primary mb-6">{title}</h1>
  <p class="text-neutral mb-6">Página no encontrada.</p>
  <a href="/" class="bg-primary text-white px-6 py-3 rounded font-medium">Volver al inicio</a>
</main>
